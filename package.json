{
  "name": "glyph",
  "version": "1.0.0",
  "description": "Lightweight daily notes, TODOs and follow-ups app",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "build": "electron-builder --win portable",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.glyph.app",
    "productName": "Glyph",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "launch.js",
      "renderer/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  }
}
