{
  "name": "glyph",
  "version": "1.1.0",
  "description": "Lightweight daily notes, TODOs and follow-ups app",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "build": "node node_modules/electron-builder/cli.js --win portable",
    "build:win": "node node_modules/electron-builder/cli.js --win",
    "build:mac": "node node_modules/electron-builder/cli.js --mac",
    "build:linux": "node node_modules/electron-builder/cli.js --linux"
  },
  "build": {
    "appId": "com.glyph.app",
    "productName": "Glyph",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "launch.js",
      "google-sync.js",
      "renderer/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "server-destroy": "^1.0.1"
  }
}